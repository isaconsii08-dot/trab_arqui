# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SERVICE_NAME=api-gateway

# ─── JWT ─────────────────────────────────────────────────────────────────────
# ⚠️ CAMBIAR por una cadena aleatoria segura antes de desplegar
JWT_SECRET=REEMPLAZAR_CON_CLAVE_SEGURA_DE_64_CARACTERES

# ─── Downstream services (localhost porque todo corre en el mismo EC2) ────────
PATRON_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
HOLDINGS_SERVICE_URL=http://localhost:3003
CIRCULATION_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# ─── CORS ─────────────────────────────────────────────────────────────────────
# ⚠️ REEMPLAZAR con las URLs reales de Vercel después del despliegue
ALLOWED_ORIGINS=https://biblioflow-patron.vercel.app,https://biblioflow-staff.vercel.app
