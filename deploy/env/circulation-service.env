# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3004
SERVICE_NAME=circulation-service

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://circulation_user:circulation_secret@localhost:5435/circulation_db?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=REEMPLAZAR_CON_CLAVE_SEGURA_DE_64_CARACTERES

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Downstream services ──────────────────────────────────────────────────────
PATRON_SERVICE_URL=http://localhost:3001
HOLDINGS_SERVICE_URL=http://localhost:3003
