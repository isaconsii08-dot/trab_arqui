# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
SERVICE_NAME=patron-service

# ─── Database ─────────────────────────────────────────────────────────────────
# localhost porque PostgreSQL corre en Docker en el mismo EC2
DATABASE_URL="postgresql://patron_user:patron_secret@localhost:5432/patron_db?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# ⚠️ DEBE ser la misma clave que en api-gateway.env
JWT_SECRET=11c7dfec0977e7da20eefed67ed5079a4ea976e3d2334f6bb99e3a3fb96efeb0
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=88f9b9aa5d2c6c39f15777a83d73507119f18b32c694a91f57b6f849d44e54e4
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Library ─────────────────────────────────────────────────────────────────
DEFAULT_LIBRARY_ID=lib-001
DEFAULT_LOAN_LIMIT=5
