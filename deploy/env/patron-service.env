# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
SERVICE_NAME=patron-service

# ─── Database ─────────────────────────────────────────────────────────────────
# localhost porque PostgreSQL corre en Docker en el mismo EC2
DATABASE_URL="postgresql://patron_user:patron_secret@localhost:5432/patron_db?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# ⚠️ DEBE ser la misma clave que en api-gateway.env
JWT_SECRET=REEMPLAZAR_CON_CLAVE_SEGURA_DE_64_CARACTERES
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTRA_CLAVE_SEGURA_DIFERENTE
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Library ─────────────────────────────────────────────────────────────────
DEFAULT_LIBRARY_ID=lib-001
DEFAULT_LOAN_LIMIT=5
