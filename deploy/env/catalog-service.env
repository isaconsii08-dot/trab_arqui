# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3002
SERVICE_NAME=catalog-service

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://catalog_user:catalog_secret@localhost:5433/catalog_db?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# ⚠️ DEBE ser la misma clave que en api-gateway.env
JWT_SECRET=REEMPLAZAR_CON_CLAVE_SEGURA_DE_64_CARACTERES

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
