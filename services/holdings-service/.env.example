# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3003
SERVICE_NAME=holdings-service

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://holdings_user:holdings_secret@localhost:5434/holdings_db?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
