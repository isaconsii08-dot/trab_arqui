{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      { "include": "generated/**/*.js",     "watchAssets": false, "outDir": "dist" },
      { "include": "generated/**/*.d.ts",   "watchAssets": false, "outDir": "dist" },
      { "include": "generated/**/*.json",   "watchAssets": false, "outDir": "dist" },
      { "include": "generated/**/*.prisma", "watchAssets": false, "outDir": "dist" }
    ]
  }
}
