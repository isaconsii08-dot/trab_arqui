# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
SERVICE_NAME=catalog-service

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://catalog_user:catalog_secret@localhost:5433/catalog_db?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
