# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
SERVICE_NAME=patron-service

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://patron_user:patron_secret@localhost:5432/patron_db?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=another_secure_random_string_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Library ─────────────────────────────────────────────────────────────────
DEFAULT_LIBRARY_ID=lib-001
DEFAULT_LOAN_LIMIT=5
